{
  "schemaVersion": 1,
  "id": "io.github.BVisagie.protonvpn",
  "name": "Proton VPN",
  "version": "1.3.0",
  "author": "BVisagie",
  "license": "MIT",
  "homepage": "https://github.com/BVisagie/omarchy-protonvpn",
  "description": "Native Omarchy bar controls for the official Proton VPN Linux CLI.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Proton VPN",
    "description": "View Proton VPN status and connect or disconnect from the Omarchy bar.",
    "category": "Network",
    "aliases": ["proton", "vpn", "protonvpn"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "linkWatchIntervalSec": 4,
      "notifications": "drops",
      "reconnectOnDrop": false,
      "rememberRecent": false,
      "barLabel": "none",
      "connectOnLogin": false,
      "autoConnectWifi": false
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Status refresh while the panel is open (seconds)",
        "min": 10,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "linkWatchIntervalSec",
        "type": "integer",
        "label": "Link check interval when NetworkManager events are unavailable (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "notifications",
        "type": "enum",
        "label": "Desktop notifications (only while the panel is closed)",
        "options": [
          { "value": "off", "label": "Off" },
          { "value": "drops", "label": "When the VPN drops" },
          { "value": "all", "label": "Drops and connections" }
        ],
        "defaultValue": "drops"
      },
      {
        "key": "reconnectOnDrop",
        "type": "boolean",
        "label": "Reconnect when the VPN drops",
        "defaultValue": false
      },
      {
        "key": "rememberRecent",
        "type": "boolean",
        "label": "Remember recent connections and the last target across restarts",
        "defaultValue": false
      },
      {
        "key": "barLabel",
        "type": "enum",
        "label": "Text beside the bar icon while connected",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "country", "label": "Country code" },
          { "value": "server", "label": "Server" },
          { "value": "city", "label": "City" }
        ],
        "defaultValue": "none"
      },
      {
        "key": "connectOnLogin",
        "type": "boolean",
        "label": "Connect when you log in",
        "defaultValue": false
      },
      {
        "key": "autoConnectWifi",
        "type": "boolean",
        "label": "Connect on Wi-Fi networks you have not trusted",
        "defaultValue": false
      }
    ]
  }
}

{
  "schemaVersion": 1,
  "id": "io.github.BVisagie.protonvpn",
  "name": "Proton VPN",
  "version": "1.0.0",
  "author": "BVisagie",
  "license": "MIT",
  "description": "Native Omarchy bar controls for the official Proton VPN Linux CLI.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Proton VPN",
    "description": "View Proton VPN status and connect or disconnect from the Omarchy bar.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      }
    ]
  }
}
